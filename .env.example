# ---------- WhatsApp (Meta Cloud API) ----------
# 1 = print bot replies in the console instead of calling Meta (safe for local testing)
# 0 = really send through WhatsApp Cloud API
WHATSAPP_MOCK=1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
# Approved template used for proactive alerts outside the 24h window (optional)
WHATSAPP_TEMPLATE_ALERT=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Public URL of this server (ngrok / Render) ----------
BASE_URL=
PORT=5000

# ---------- Admin API (certificate office) ----------
ADMIN_KEY=change-me-to-a-long-random-string

# ---------- Payments: mock | razorpay ----------
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Optional LLM (Anthropic) for FAQ answers + personalised study tips ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- Academic rules ----------
ATTENDANCE_THRESHOLD=75
ALERT_HOUR=9
ALERT_COOLDOWN_DAYS=3
