# ---------- WhatsApp (Meta Cloud API) ----------
# 1 = print bot replies in the console instead of calling Meta (safe for local testing)
# 0 = really send through WhatsApp Cloud API
WHATSAPP_MOCK=1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=contxpert_verify_123
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
# Approved template used for proactive alerts outside the 24h window (optional)
WHATSAPP_TEMPLATE_ALERT=
WHATSAPP_TEMPLATE_LANG=en

# ---------- PostgreSQL ----------
# Local:  postgresql://postgres:yourpassword@localhost:5432/contxpert
# Render: paste the "Internal Database URL" of your Render PostgreSQL here
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/contxpert
# 1 = on first start (empty database) import the CSV files in ./data once. Afterwards the database is the source of truth.
AUTO_SEED_CSV=1
# 1 = wipe + re-import the CSV files on EVERY start (old behaviour; leave 0 once you manage data from the admin console)
CSV_SYNC=0

# ---------- Public URL of this server (ngrok / Render) ----------
BASE_URL=http://localhost:5000
PORT=5000

# ---------- Admin console (/console) + admin API: the ADMIN_KEY is the console password ----------
ADMIN_KEY=change-me-to-a-long-random-string

# ---------- Payments: mock | razorpay ----------
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Optional LLM (Anthropic) for FAQ answers + personalised study tips ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Certificate fees (INR). Change any value and restart ContXpert.
CERT_FEE_BONAFIDE=100
CERT_FEE_STUDY=100
CERT_FEE_CONDUCT=100
CERT_FEE_TRANSCRIPT=500
CERT_FEE_NOC=150

# ---------- Academic rules ----------
ATTENDANCE_THRESHOLD=75
ALERT_HOUR=9
ALERT_COOLDOWN_DAYS=3
